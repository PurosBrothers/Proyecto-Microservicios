### 20. Test de respuesta completa - Verificar que el DTO incluye datos de clasificación
GET http://localhost:8084/items/1
Accept: application/json

> {%
client.test("Verificar estructura de respuesta ItemDTO", function() {
    client.assert(response.status === 200, "Status code should be 200");
    
    var json = response.body;
    
    // Verificar campos básicos del Item
    client.assert(json.id !== undefined, "Item should have id");
    client.assert(json.titulo !== undefined, "Item should have titulo");
    client.assert(json.descripcion !== undefined, "Item should have descripcion");
    client.assert(json.clasificacionId !== undefined, "Item should have clasificacionId");
    
    // Verificar campos heredados de clasificación
    client.assert(json.lugarInicio !== undefined, "Item should have lugarInicio from classification");
    client.assert(json.precio !== undefined, "Item should have precio from classification");
    client.assert(json.fechaDisponibilidadInicio !== undefined, "Item should have fechaDisponibilidadInicio");
    client.assert(json.fechaDisponibilidadFin !== undefined, "Item should have fechaDisponibilidadFin");
    client.assert(json.capacidadMaxima !== undefined, "Item should have capacidadMaxima");
    
    // Verificar campos de solo lectura
    client.assert(json.visualizaciones !== undefined, "Item should have visualizaciones");
    client.assert(json.calificacionPromedio !== undefined, "Item should have calificacionPromedio");
    
    client.log("ItemDTO structure validated successfully");
});
%}

### 21. Test creación exitosa con diferentes tipos de clasificación
POST http://localhost:8084/items
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "clasificacionId": 2,
  "titulo": "Restaurante Vegetariano Innovador",
  "descripcion": "Experiencia culinaria única con ingredientes orgánicos y técnicas de cocina molecular vegetariana",
  "stock": 25
}

> {%
client.test("Verificar creación exitosa de Item", function() {
    client.assert(response.status === 201, "Status code should be 201 for successful creation");
    
    var json = response.body;
    client.assert(json.id !== undefined, "Created item should have an ID");
    client.assert(json.clasificacionId === 2, "Should have correct clasificacionId");
    client.assert(json.titulo === "Restaurante Vegetariano Innovador", "Should have correct titulo");
    client.assert(json.stock === 25, "Should have correct stock");
    
    // Los datos de clasificación deberían estar presentes
    client.assert(json.lugarInicio !== undefined, "Should inherit lugarInicio from classification");
    client.assert(json.precio !== undefined, "Should inherit precio from classification");
    
    client.global.set("created_item_id", json.id);
    client.log("Item created successfully with ID: " + json.id);
});
%}

### 22. Test actualización con nueva estructura
PUT http://localhost:8084/items/{{created_item_id}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "id": {{created_item_id}},
  "clasificacionId": 2,
  "titulo": "Restaurante Vegetariano Premium - Actualizado",
  "descripcion": "Descripción actualizada con nuevos platos de temporada y experiencias gastronómicas exclusivas",
  "stock": 20
}

> {%
client.test("Verificar actualización exitosa", function() {
    client.assert(response.status === 200, "Status code should be 200 for successful update");
    
    var json = response.body;
    client.assert(json.titulo === "Restaurante Vegetariano Premium - Actualizado", "Titulo should be updated");
    client.assert(json.stock === 20, "Stock should be updated");
    
    client.log("Item updated successfully");
});
%}